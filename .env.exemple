# Template for local development — copy to .env.local (ENV defaults to "local").
# The real settings contract lives in core/config.py.

# ── Core ──
ENV=local

# ── CRM database (read: members, accounts, roles, the module; insert: notifications) ──
CRM_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/crm_db
CRM_DB_POOL_SIZE=20
CRM_DB_MAX_OVERFLOW=10
CRM_DB_POOL_RECYCLE=3600
CRM_DB_POOL_TIMEOUT=30
CRM_DB_SSL=false

# ── Local database (requests, signers, fields, revisions, the evidence log) ──
LOCAL_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/signature_local
LOCAL_DB_POOL_SIZE=20
LOCAL_DB_MAX_OVERFLOW=10
LOCAL_DB_POOL_RECYCLE=3600
LOCAL_DB_POOL_TIMEOUT=30
LOCAL_DB_SSL=false

# ── NATS ──
NATS_URL=nats://localhost:4222

# ── Storage (S3-compatible, MinIO in dev) ──
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_BUCKET=crm-files
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
STORAGE_REGION=us-east-1
# The documents bucket: originals read under the requesting domain's prefix,
# everything of a request written under signature/{community}/{request}/.
OUTPUT_BUCKET=optimce-documents
TEMPLATES_BUCKET=optimce-templates

# ── document-generation (the evidence report) ──
DOCGEN_REQUEST_SUBJECT=docgen.request
DOCGEN_RESULT_SUBJECT=docgen.result.signature
EVIDENCE_TEMPLATE_URI=s3://optimce-templates/signature/evidence/v3/

# ── The seal (worker only) ──
# A PKCS#12 mounted as a secret. Dev: the test PKI's (python -m devpki.serve).
SEAL_PKCS12_PATH=/pki/seal.p12
SEAL_PKCS12_PASSPHRASE=dev-only
SEAL_CA_CHAIN_PATHS=
SEAL_TRUST_ROOT_PATHS=/pki/root.cer
# RFC 3161 authorities, in order. Production: one on an EU trusted list.
TSA_URLS=http://localhost:9000/optimce-dev/tsa/tsa
TSA_TIMEOUT_SECONDS=10

# ── Signing ──
STEP_UP_MAX_AGE_SECONDS=300
APP_BASE_URL=http://localhost:8087
SWEEP_ENABLED=true
SWEEP_INTERVAL_SECONDS=3600

# ── Realtime (optional) ──
REALTIME_ENABLED=false
REALTIME_REDIS_URL=

# ── CORS ──
ALLOW_ORIGIN=*

# ── Observability ──
LOGGING_TOKEN=
LOGGING_TRACES_URL=
LOGGING_LOGS_URL=
LOGGING_METRICS_URL=
